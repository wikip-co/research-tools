VAULT_ADDR=https://vault.wikip.co
VAULT_GOOGLE_SECRET_PATH=secret/data/Google/oauth/credentials
VAULT_CLOUDINARY_SECRET_PATH=secret/data/cloudinary
VAULT_KV_VERSION=2

# Optional backward-compatible combined secret path:
# VAULT_SECRET_PATH=kv/data/content-agent/prod

# Set one auth mode:
VAULT_USERNAME=
VAULT_PASSWORD=
# VAULT_PASSWORD_FILE=/run/secrets/vault_password
# VAULT_TOKEN=
# VAULT_TOKEN_FILE=/run/secrets/vault_token
VAULT_AUTH_PATH=auth/userpass/login

CONTENT_REPO_HOST_PATH=../content
GMAIL_READER_DB_HOST_PATH=./runtime/gmail-reader
GMAIL_READER_WEB_HOST=0.0.0.0
GMAIL_READER_WEB_PORT=8765

# Local content repo workflow
# If CONTENT_REPO_ROOT is not set explicitly, agent-workflow uses a managed clone here:
CONTENT_REPO_MANAGED_ROOT=./runtime/content-repo
# Optional local source repo to clone from on first run:
CONTENT_REPO_SOURCE_PATH=../content
# Optional remote to clone when no local source repo is available:
# CONTENT_REPO_GIT_URL=git@github.com:your-org/content.git
CONTENT_REPO_REF=main

# Optional Codex web job overrides
# RESEARCH_WORKSPACE_ROOT=/home/anthony/Research
# CODEX_BIN=/home/anthony/n/bin/codex
# CODEX_WEB_EXTRA_ARGS="--model gpt-5.4"

# Optional for Unpaywall enrichment in web-scraper
# UNPAYWALL_EMAIL=you@example.com

# Optional field overrides for Vault payloads
VAULT_SECRET_JSON_KEY=google_workspace_cli_credentials_json
VAULT_CLOUDINARY_CLOUD_NAME_KEY=cloud_name
VAULT_CLOUDINARY_API_KEY_KEY=key
VAULT_CLOUDINARY_API_SECRET_KEY=secret
