[Unit]
Description=Sync Google Scholar alert emails into the Research database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Paths assume the workspace at ~/Projects/Research; GMAIL_READER_DB comes from .env.
WorkingDirectory=%h/Projects/Research/research-tools
EnvironmentFile=-%h/Projects/Research/research-tools/.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GMAIL_SYNC_DAYS_BACK=3
Environment=GMAIL_SYNC_MAX_MESSAGES=100
ExecStart=%h/Projects/Research/research-tools/scripts/sync-scholar-alerts
