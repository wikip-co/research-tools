[Unit]
Description=Research SQLite triage web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/anthony/Research/research-tools
Environment=PATH=/home/anthony/.local/bin:/home/anthony/n/bin:/usr/local/bin:/usr/bin:/bin
Environment=GMAIL_READER_DB=/home/anthony/Research/research-tools/gmail-reader/data/scholar-alerts.db
Environment=GMAIL_READER_WEB_HOST=0.0.0.0
Environment=GMAIL_READER_WEB_PORT=8765
Environment=RESEARCH_WORKSPACE_ROOT=/home/anthony/Research
Environment=CODEX_BIN=/home/anthony/n/bin/codex
ExecStart=/home/anthony/Research/research-tools/agent-workflow triage-ui --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
