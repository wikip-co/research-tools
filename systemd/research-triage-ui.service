[Unit]
Description=Research SQLite triage web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Paths assume the workspace at ~/Projects/Research. Host settings such as
# GMAIL_READER_DB, CONTENT_REPO_ROOT and RESEARCH_WORKSPACE_ROOT come from .env.
WorkingDirectory=%h/Projects/Research/research-tools
EnvironmentFile=-%h/Projects/Research/research-tools/.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Loopback unless .env sets GMAIL_READER_WEB_HOST. The UI can start a
# full-access agent run, so LAN exposure is an explicit choice.
ExecStart=%h/Projects/Research/research-tools/agent-workflow triage-ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
