[Unit]
Description=Process one queued research article with the local llama.cpp model
After=network-online.target research-scholar-sync.service
Wants=network-online.target

[Service]
Type=oneshot
# Paths assume the workspace at ~/Projects/Research. GMAIL_READER_DB,
# CONTENT_REPO_ROOT, LOCAL_LLM_BASE_URL and LOCAL_LLM_MODEL come from .env.
WorkingDirectory=%h/Projects/Research/research-tools
EnvironmentFile=-%h/Projects/Research/research-tools/.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Projects/Research/research-tools/agent-workflow enqueue-local-backlog --domain "Natural Healing" --min-score 12 --limit 1
# The lease outlives the unit timeout, so a run killed by systemd is reclaimed
# by a later run instead of overlapping with it.
ExecStart=%h/Projects/Research/research-tools/agent-workflow local-worker --max-jobs 1 --lease-seconds 3600 --publish
TimeoutStartSec=45min
