run_triage_ui() {
  require_command uv
  local args=("$@")
  local i
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "--db" && $((i + 1)) -lt ${#args[@]} ]]; then
      if [[ "${args[$((i + 1))]}" != /* ]]; then
        args[$((i + 1))]="$(cd "$(dirname "${args[$((i + 1))]}")" && pwd)/$(basename "${args[$((i + 1))]}")"
      fi
    fi
  done
  if [[ -n "${GMAIL_READER_DB:-}" ]]; then
    local db_path="$GMAIL_READER_DB"
    if [[ "$db_path" != /* ]]; then
      db_path="$(cd "$(dirname "$db_path")" && pwd)/$(basename "$db_path")"
    fi
    args=(--db "$db_path" "${args[@]}")
  fi
  uv run --directory "$AGENT_TOOLS_ROOT/gmail-reader" gmail-reader-web "${args[@]}"
}

run_doctor() {
  require_command jq
  local managed_exists=0 configured_root_exists=0 source_exists=0
  local resolved_source=""
  local repo_root_display="${CONTENT_REPO_ROOT:-$CONTENT_REPO_MANAGED_ROOT}"

  if [[ -n "${CONTENT_REPO_ROOT:-}" && -d "$CONTENT_REPO_ROOT" ]]; then
    configured_root_exists=1
  fi
  if is_git_repo "$CONTENT_REPO_MANAGED_ROOT"; then
    managed_exists=1
  fi
  resolved_source="$(resolve_content_repo_source)"
  if [[ -n "$resolved_source" && -d "$resolved_source" ]]; then
    source_exists=1
  fi

  jq -n \
    --arg agent_tools_root "$AGENT_TOOLS_ROOT" \
    --arg content_repo_root "$repo_root_display" \
    --arg managed_root "$CONTENT_REPO_MANAGED_ROOT" \
    --arg source_path "$resolved_source" \
    --arg git_url "${CONTENT_REPO_GIT_URL:-}" \
    --arg ref "$CONTENT_REPO_REF" \
    --arg gmail_db "${GMAIL_READER_DB:-}" \
    --argjson uv "$(command -v uv >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson gh "$(command -v gh >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson gws "$(command -v gws >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson git "$(command -v git >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson vault "$(command -v vault >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson agent_browser "$(command -v agent-browser >/dev/null 2>&1 && printf 'true' || printf 'false')" \
    --argjson configured_root_exists "$([[ "$configured_root_exists" -eq 1 ]] && printf 'true' || printf 'false')" \
    --argjson managed_root_exists "$([[ "$managed_exists" -eq 1 ]] && printf 'true' || printf 'false')" \
    --argjson source_exists "$([[ "$source_exists" -eq 1 ]] && printf 'true' || printf 'false')" \
    --argjson cloudinary_env "$([[ -n "${CLOUDINARY_CLOUD_NAME:-}" && -n "${CLOUDINARY_API_KEY:-}" && -n "${CLOUDINARY_API_SECRET:-}" ]] && printf 'true' || printf 'false')" \
    --argjson google_env "$([[ -n "${GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE:-}" ]] && printf 'true' || printf 'false')" \
    '{
      ok: true,
      result: {
        commands: {
          uv: $uv,
          gh: $gh,
          gws: $gws,
          git: $git,
          vault: $vault,
          agent_browser: $agent_browser
        },
        paths: {
          agent_tools_root: $agent_tools_root,
          content_repo_root: $content_repo_root,
          managed_content_repo_root: $managed_root,
          content_repo_source_path: $source_path,
          content_repo_git_url: $git_url,
          content_repo_ref: $ref,
          gmail_reader_db: $gmail_db
        },
        status: {
          configured_content_repo_exists: $configured_root_exists,
          managed_content_repo_exists: $managed_root_exists,
          source_content_repo_exists: $source_exists,
          cloudinary_env_loaded: $cloudinary_env,
          google_env_loaded: $google_env
        }
      }
    }'
}

run_setup() {
  local errors=0
  local source_path=""

  printf 'Setting up research-tools...\n\n'

  # Check required commands
  printf '==> Checking required commands...\n'
  for cmd in uv git vault gws jq; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  ✓ %s found\n' "$cmd"
    else
      printf '  ✗ %s NOT FOUND\n' "$cmd"
      ((errors++))
    fi
  done
  printf '\n'

  # Sync dependencies for each tool
  printf '==> Installing tool dependencies...\n'
  printf '  → workspace: '
  if (cd "$AGENT_TOOLS_ROOT" && uv sync --all-packages --quiet 2>/dev/null); then
    printf 'OK\n'
  else
    printf 'FAILED\n'
    ((errors++))
  fi
  printf '\n'

  # Ensure the managed content repo exists for local workflows.
  printf '==> Checking content repo...\n'
  source_path="$(resolve_content_repo_source)"
  if ensure_content_repo_ready >/dev/null 2>&1; then
    printf '  ✓ Working copy ready at %s\n' "$CONTENT_REPO_ROOT"
  else
    printf '  ✗ Unable to prepare content repo working copy\n'
    if [[ -n "$source_path" ]]; then
      printf '    source path: %s\n' "$source_path"
    elif [[ -n "$CONTENT_REPO_GIT_URL" ]]; then
      printf '    git url: %s\n' "$CONTENT_REPO_GIT_URL"
    else
      printf '    configure CONTENT_REPO_SOURCE_PATH or CONTENT_REPO_GIT_URL\n'
    fi
    ((errors++))
  fi
  printf '\n'

  # Install Playwright browsers for web-scraper
  printf '==> Installing Playwright browsers...\n'
  local scraper_dir="$AGENT_TOOLS_ROOT/web-scraper"
  if [[ -d "$scraper_dir" ]]; then
    # Check if already installed
    if compgen -G "$HOME/.cache/ms-playwright/chromium-*" >/dev/null; then
      printf '  ✓ Chromium already installed\n'
    elif (cd "$scraper_dir" && uv run playwright install chromium 2>&1 | grep -q -E "(downloaded|already)"); then
      printf '  ✓ Chromium installed\n'
    else
      # Try installation and check result
      if (cd "$scraper_dir" && uv run playwright install chromium >/dev/null 2>&1); then
        printf '  ✓ Chromium installed\n'
      else
        printf '  ⚠ Chromium may need manual installation\n'
      fi
    fi
  fi
  printf '\n'

  # Check agent-browser availability for screenshot capture and fallback scraping
  printf '==> Checking agent-browser...\n'
  if command -v agent-browser >/dev/null 2>&1; then
    printf '  ✓ agent-browser found\n'
  else
    printf '  ⚠ agent-browser not found (browser screenshots and scrape fallback will be unavailable)\n'
  fi
  printf '\n'

  # Check Vault connectivity
  printf '==> Checking Vault connectivity...\n'
  if vault status >/dev/null 2>&1; then
    printf '  ✓ Vault is accessible\n'

    # Try to load credentials
    printf '  → Testing credential retrieval: '
    if source "$AGENT_TOOLS_ROOT/auth-bootstrap" 2>/dev/null; then
      printf 'OK\n'
    else
      printf 'FAILED (run: source auth-bootstrap)\n'
      ((errors++))
    fi
  else
    printf '  ✗ Cannot connect to Vault\n'
    ((errors++))
  fi
  printf '\n'

  # Check Gmail auth
  printf '==> Checking Gmail authentication...\n'
  if [[ -n "${GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE:-}" ]] && [[ -f "$GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE" ]]; then
    printf '  ✓ Credentials file exists\n'

    # Test Gmail access
    printf '  → Testing Gmail access: '
    if (cd "$AGENT_TOOLS_ROOT/gmail-reader" && uv run gmail-reader alerts >/dev/null 2>&1); then
      printf 'OK\n'
    else
      printf 'FAILED\n'
      ((errors++))
    fi
  else
    printf '  ✗ No credentials loaded (run: source auth-bootstrap)\n'
    ((errors++))
  fi
  printf '\n'

  # Summary
  if ((errors == 0)); then
    printf '==> Setup complete! All checks passed.\n'
  else
    printf '==> Setup completed with %d error(s).\n' "$errors"
  fi

  return $errors
}

main() {
  local command="${1:-help}"
  if (($# > 0)); then
    shift
  fi

  case "$command" in
    setup)
      run_setup "$@"
      ;;
    backlog)
      run_backlog "$@"
      ;;
    queue)
      run_queue "$@"
      ;;
    match)
      run_match "$@"
      ;;
    search)
      run_search "$@"
      ;;
    doctor)
      run_doctor "$@"
      ;;
    sync-content-repo)
      sync_content_repo
      ;;
    prepare)
      run_prepare "$@"
      ;;
    intake)
      run_intake "$@"
      ;;
    ingest-paper)
      run_ingest_paper "$@"
      ;;
    append)
      run_append "$@"
      ;;
    tags)
      run_tags "$@"
      ;;
    audit-tags)
      run_audit_tags "$@"
      ;;
    lint-frontmatter)
      run_lint_frontmatter "$@"
      ;;
    check-ref)
      run_check_ref "$@"
      ;;
    check-duplicate-paper)
      run_check_duplicate_paper "$@"
      ;;
    archive-source)
      run_archive_source "$@"
      ;;
    open-pr)
      run_open_pr "$@"
      ;;
    publish-pr)
      run_publish_pr "$@"
      ;;
    triage-ui)
      run_triage_ui "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      printf 'Unknown command: %s\n\n' "$command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
