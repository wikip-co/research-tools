#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_TOOLS_ROOT="${AGENT_TOOLS_ROOT:-$SCRIPT_DIR}"
CONTENT_REPO_ROOT="${CONTENT_REPO_ROOT:-$(pwd)}"
WIKI_AUTOMATION_DIR="$AGENT_TOOLS_ROOT/wiki-automation"
DEFAULT_OUTPUT_DIR="${AGENT_OUTPUT_DIR:-$AGENT_TOOLS_ROOT/out}"

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$cmd" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage:
  agent-workflow setup                              # Install dependencies and verify auth
  agent-workflow backlog [wiki-automation backlog args...]
  agent-workflow queue [wiki-automation queue args...]
  agent-workflow match "<title or topic>" [wiki-automation match args...]
  agent-workflow search "<query>" [wiki-automation search args...]
  agent-workflow prepare "<url>" [wiki-automation prepare args...]
  agent-workflow append "<url>" --target "<path>" [wiki-automation append args...]
  agent-workflow tags [--suggest "<query>"] [--limit N]
  agent-workflow check-ref "<url>"
  agent-workflow help

Authentication:
  source auth-bootstrap                             # Load Google credentials from Vault
EOF
}

run_queue() {
  require_command uv

  local gmail_query="label:inbox newer_than:1d"
  local days_back="1"
  local max_messages="25"
  local max_results="10"
  local output_dir="$DEFAULT_OUTPUT_DIR"

  local passthrough=()
  while (($#)); do
    case "$1" in
      --gmail-query|--days-back|--max-messages|--max-results|--output-dir)
        if (($# < 2)); then
          printf 'Missing value for %s\n' "$1" >&2
          exit 1
        fi
        case "$1" in
          --gmail-query) gmail_query="$2" ;;
          --days-back) days_back="$2" ;;
          --max-messages) max_messages="$2" ;;
          --max-results) max_results="$2" ;;
          --output-dir) output_dir="$2" ;;
        esac
        shift 2
        ;;
      *)
        passthrough+=("$1")
        shift
        ;;
    esac
  done

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation queue \
      --gmail-query "$gmail_query" \
      --days-back "$days_back" \
      --max-messages "$max_messages" \
      --max-results "$max_results" \
      --output-dir "$output_dir" \
      "${passthrough[@]}"
}

run_match() {
  require_command uv
  if (($# < 1)); then
    printf 'match requires a title or topic\n' >&2
    exit 1
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation match "$@"
}

run_search() {
  require_command uv
  if (($# < 1)); then
    printf 'search requires a query\n' >&2
    exit 1
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation search "$@"
}

run_backlog() {
  require_command uv

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation backlog "$@"
}

run_prepare() {
  require_command uv
  if (($# < 1)); then
    printf 'prepare requires a URL\n' >&2
    exit 1
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation prepare "$@"
}

run_append() {
  require_command uv
  if (($# < 1)); then
    printf 'append requires a URL\n' >&2
    exit 1
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation append "$@"
}

run_tags() {
  require_command uv

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation tags "$@"
}

run_check_ref() {
  require_command uv
  if (($# < 1)); then
    printf 'check-ref requires a URL\n' >&2
    exit 1
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation check-ref "$@"
}

run_setup() {
  local errors=0

  printf 'Setting up research-tools...\n\n'

  # Check required commands
  printf '==> Checking required commands...\n'
  for cmd in uv vault gws; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  ✓ %s found\n' "$cmd"
    else
      printf '  ✗ %s NOT FOUND\n' "$cmd"
      ((errors++))
    fi
  done
  printf '\n'

  # Sync dependencies for each tool
  printf '==> Installing tool dependencies...\n'
  for tool_dir in gmail-reader wiki-automation web-scraper image-upload; do
    local dir="$AGENT_TOOLS_ROOT/$tool_dir"
    if [[ -d "$dir" ]]; then
      printf '  → %s: ' "$tool_dir"
      if (cd "$dir" && uv sync --quiet 2>/dev/null); then
        printf 'OK\n'
      else
        printf 'FAILED\n'
        ((errors++))
      fi
    fi
  done
  printf '\n'

  # Install Playwright browsers for web-scraper
  printf '==> Installing Playwright browsers...\n'
  local scraper_dir="$AGENT_TOOLS_ROOT/web-scraper"
  if [[ -d "$scraper_dir" ]]; then
    # Check if already installed
    if [[ -d "$HOME/.cache/ms-playwright/chromium-"* ]]; then
      printf '  ✓ Chromium already installed\n'
    elif (cd "$scraper_dir" && uv run playwright install chromium 2>&1 | grep -q -E "(downloaded|already)"); then
      printf '  ✓ Chromium installed\n'
    else
      # Try installation and check result
      if (cd "$scraper_dir" && uv run playwright install chromium >/dev/null 2>&1); then
        printf '  ✓ Chromium installed\n'
      else
        printf '  ⚠ Chromium may need manual installation\n'
      fi
    fi
  fi
  printf '\n'

  # Check Vault connectivity
  printf '==> Checking Vault connectivity...\n'
  if vault status >/dev/null 2>&1; then
    printf '  ✓ Vault is accessible\n'

    # Try to load credentials
    printf '  → Testing credential retrieval: '
    if source "$AGENT_TOOLS_ROOT/auth-bootstrap" 2>/dev/null; then
      printf 'OK\n'
    else
      printf 'FAILED (run: source auth-bootstrap)\n'
      ((errors++))
    fi
  else
    printf '  ✗ Cannot connect to Vault\n'
    ((errors++))
  fi
  printf '\n'

  # Check Gmail auth
  printf '==> Checking Gmail authentication...\n'
  if [[ -n "${GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE:-}" ]] && [[ -f "$GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE" ]]; then
    printf '  ✓ Credentials file exists\n'

    # Test Gmail access
    printf '  → Testing Gmail access: '
    if (cd "$AGENT_TOOLS_ROOT/gmail-reader" && uv run gmail-reader alerts >/dev/null 2>&1); then
      printf 'OK\n'
    else
      printf 'FAILED\n'
      ((errors++))
    fi
  else
    printf '  ✗ No credentials loaded (run: source auth-bootstrap)\n'
    ((errors++))
  fi
  printf '\n'

  # Summary
  if ((errors == 0)); then
    printf '==> Setup complete! All checks passed.\n'
  else
    printf '==> Setup completed with %d error(s).\n' "$errors"
  fi

  return $errors
}

main() {
  local command="${1:-help}"
  if (($# > 0)); then
    shift
  fi

  case "$command" in
    setup)
      run_setup "$@"
      ;;
    backlog)
      run_backlog "$@"
      ;;
    queue)
      run_queue "$@"
      ;;
    match)
      run_match "$@"
      ;;
    search)
      run_search "$@"
      ;;
    prepare)
      run_prepare "$@"
      ;;
    append)
      run_append "$@"
      ;;
    tags)
      run_tags "$@"
      ;;
    check-ref)
      run_check_ref "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      printf 'Unknown command: %s\n\n' "$command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
