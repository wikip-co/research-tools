WIKI_AUTOMATION_DIR="$AGENT_TOOLS_ROOT/wiki-automation"
DEFAULT_OUTPUT_DIR="${AGENT_OUTPUT_DIR:-$AGENT_TOOLS_ROOT/out}"

load_dotenv() {
  # Tests/CI can set AGENT_WORKFLOW_SKIP_DOTENV=1 so a host .env (e.g. production
  # CONTENT_REPO_ROOT) cannot override intentionally configured temp paths.
  if [[ "${AGENT_WORKFLOW_SKIP_DOTENV:-}" == "1" ]]; then
    return 0
  fi
  local candidate raw_line line key value
  for candidate in "$SCRIPT_DIR/.env" "$PWD/.env"; do
    if [[ -f "$candidate" ]]; then
      while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        line="${raw_line#"${raw_line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -z "$line" || "$line" == \#* ]]; then
          continue
        fi
        if [[ "$line" == export\ * ]]; then
          line="${line#export }"
        fi
        if [[ "$line" != *=* ]]; then
          continue
        fi
        key="${line%%=*}"
        value="${line#*=}"
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ ${#value} -ge 2 ]]; then
          if [[ "${value:0:1}" == '"' && "${value: -1}" == '"' ]]; then
            value="${value:1:${#value}-2}"
          elif [[ "${value:0:1}" == "'" && "${value: -1}" == "'" ]]; then
            value="${value:1:${#value}-2}"
          fi
        fi
        # Only fill variables that are unset in this process. Do not treat an
        # intentionally empty value (e.g. CONTENT_REPO_ROOT="") as missing, or
        # .env production paths will clobber managed-clone test/config mode.
        if [[ -n "$key" && ! -v "$key" ]]; then
          export "$key=$value"
        fi
      done <"$candidate"
      return
    fi
  done
}

# Load .env before binding defaults so unset vars can come from the file, while
# caller-provided values (including empty CONTENT_REPO_ROOT) always win.
load_dotenv

CONTENT_REPO_MANAGED_ROOT="${CONTENT_REPO_MANAGED_ROOT:-$AGENT_TOOLS_ROOT/runtime/content-repo}"
CONTENT_REPO_SOURCE_PATH="${CONTENT_REPO_SOURCE_PATH:-}"
CONTENT_REPO_GIT_URL="${CONTENT_REPO_GIT_URL:-}"
CONTENT_REPO_REF="${CONTENT_REPO_REF:-main}"
CONTENT_REPO_ROOT="${CONTENT_REPO_ROOT:-}"

default_content_source_path() {
  local candidate="$SCRIPT_DIR/../content"
  if [[ -d "$candidate/.git" ]]; then
    (cd "$candidate" && pwd)
  fi
}

resolve_content_repo_source() {
  if [[ -n "$CONTENT_REPO_SOURCE_PATH" ]]; then
    printf '%s\n' "$CONTENT_REPO_SOURCE_PATH"
    return
  fi
  default_content_source_path
}

is_git_repo() {
  local path="$1"
  [[ -d "$path" ]] && git -C "$path" rev-parse --git-dir >/dev/null 2>&1
}

ensure_content_repo_ready() {
  local source_path
  if [[ -n "$CONTENT_REPO_ROOT" ]]; then
    if ! is_git_repo "$CONTENT_REPO_ROOT"; then
      printf 'Configured CONTENT_REPO_ROOT is not a git repo: %s\n' "$CONTENT_REPO_ROOT" >&2
      exit 1
    fi
    export CONTENT_REPO_ROOT
    return
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_MANAGED_ROOT"
  if is_git_repo "$CONTENT_REPO_ROOT"; then
    export CONTENT_REPO_ROOT
    return
  fi

  source_path="$(resolve_content_repo_source)"
  mkdir -p "$(dirname "$CONTENT_REPO_ROOT")"

  if [[ -n "$source_path" && -d "$source_path/.git" ]]; then
    require_command git
    git clone --quiet --local --no-hardlinks "$source_path" "$CONTENT_REPO_ROOT" >&2
    export CONTENT_REPO_ROOT
    return
  fi

  if [[ -n "$CONTENT_REPO_GIT_URL" ]]; then
    require_command git
    git clone --quiet --branch "$CONTENT_REPO_REF" "$CONTENT_REPO_GIT_URL" "$CONTENT_REPO_ROOT" >&2
    export CONTENT_REPO_ROOT
    return
  fi

  cat >&2 <<EOF
Content repo is not configured.
Set one of:
  CONTENT_REPO_ROOT=/path/to/working-copy
  CONTENT_REPO_SOURCE_PATH=/path/to/source-repo
  CONTENT_REPO_GIT_URL=https://...
EOF
  exit 1
}

sync_content_repo() {
  ensure_content_repo_ready
  require_command git

  local failed=0 step
  if [[ -n "$CONTENT_REPO_REF" ]]; then
    for step in "fetch --all --prune --quiet" "checkout --quiet $CONTENT_REPO_REF" "pull --ff-only --quiet"; do
      # shellcheck disable=SC2086  # each step is a fixed word list
      if ! git -C "$CONTENT_REPO_ROOT" $step >&2; then
        printf 'Content repo sync step failed: git %s\n' "$step" >&2
        failed=1
        break
      fi
    done
  fi
  jq -n \
    --arg root "$CONTENT_REPO_ROOT" \
    --arg ref "$CONTENT_REPO_REF" \
    --arg head "$(git -C "$CONTENT_REPO_ROOT" rev-parse HEAD 2>/dev/null || true)" \
    --argjson ok "$([[ "$failed" -eq 0 ]] && printf true || printf false)" \
    '{ok: $ok, result: {content_repo_root: $root, ref: $ref, head: $head}}'
  return "$failed"
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$cmd" >&2
    exit 1
  fi
}

