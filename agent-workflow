#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_TOOLS_ROOT="${AGENT_TOOLS_ROOT:-$SCRIPT_DIR}"
WIKI_AUTOMATION_DIR="$AGENT_TOOLS_ROOT/wiki-automation"
DEFAULT_OUTPUT_DIR="${AGENT_OUTPUT_DIR:-$AGENT_TOOLS_ROOT/out}"
CONTENT_REPO_MANAGED_ROOT="${CONTENT_REPO_MANAGED_ROOT:-$AGENT_TOOLS_ROOT/runtime/content-repo}"
CONTENT_REPO_SOURCE_PATH="${CONTENT_REPO_SOURCE_PATH:-}"
CONTENT_REPO_GIT_URL="${CONTENT_REPO_GIT_URL:-}"
CONTENT_REPO_REF="${CONTENT_REPO_REF:-main}"
CONTENT_REPO_ROOT="${CONTENT_REPO_ROOT:-}"

load_dotenv() {
  local candidate raw_line line key value
  for candidate in "$SCRIPT_DIR/.env" "$PWD/.env"; do
    if [[ -f "$candidate" ]]; then
      while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        line="${raw_line#"${raw_line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -z "$line" || "$line" == \#* ]]; then
          continue
        fi
        if [[ "$line" == export\ * ]]; then
          line="${line#export }"
        fi
        if [[ "$line" != *=* ]]; then
          continue
        fi
        key="${line%%=*}"
        value="${line#*=}"
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ ${#value} -ge 2 ]]; then
          if [[ "${value:0:1}" == '"' && "${value: -1}" == '"' ]]; then
            value="${value:1:${#value}-2}"
          elif [[ "${value:0:1}" == "'" && "${value: -1}" == "'" ]]; then
            value="${value:1:${#value}-2}"
          fi
        fi
        if [[ -n "$key" && -z "${!key:-}" ]]; then
          export "$key=$value"
        fi
      done <"$candidate"
      return
    fi
  done
}

load_dotenv

default_content_source_path() {
  local candidate="$SCRIPT_DIR/../content"
  if [[ -d "$candidate/.git" ]]; then
    (cd "$candidate" && pwd)
  fi
}

resolve_content_repo_source() {
  if [[ -n "$CONTENT_REPO_SOURCE_PATH" ]]; then
    printf '%s\n' "$CONTENT_REPO_SOURCE_PATH"
    return
  fi
  default_content_source_path
}

is_git_repo() {
  local path="$1"
  [[ -d "$path" ]] && git -C "$path" rev-parse --git-dir >/dev/null 2>&1
}

ensure_content_repo_ready() {
  local source_path
  if [[ -n "$CONTENT_REPO_ROOT" ]]; then
    if ! is_git_repo "$CONTENT_REPO_ROOT"; then
      printf 'Configured CONTENT_REPO_ROOT is not a git repo: %s\n' "$CONTENT_REPO_ROOT" >&2
      exit 1
    fi
    export CONTENT_REPO_ROOT
    return
  fi

  CONTENT_REPO_ROOT="$CONTENT_REPO_MANAGED_ROOT"
  if is_git_repo "$CONTENT_REPO_ROOT"; then
    export CONTENT_REPO_ROOT
    return
  fi

  source_path="$(resolve_content_repo_source)"
  mkdir -p "$(dirname "$CONTENT_REPO_ROOT")"

  if [[ -n "$source_path" && -d "$source_path/.git" ]]; then
    require_command git
    git clone --local --no-hardlinks "$source_path" "$CONTENT_REPO_ROOT" >/dev/null 2>&1
    export CONTENT_REPO_ROOT
    return
  fi

  if [[ -n "$CONTENT_REPO_GIT_URL" ]]; then
    require_command git
    git clone --branch "$CONTENT_REPO_REF" "$CONTENT_REPO_GIT_URL" "$CONTENT_REPO_ROOT" >/dev/null 2>&1
    export CONTENT_REPO_ROOT
    return
  fi

  cat >&2 <<EOF
Content repo is not configured.
Set one of:
  CONTENT_REPO_ROOT=/path/to/working-copy
  CONTENT_REPO_SOURCE_PATH=/path/to/source-repo
  CONTENT_REPO_GIT_URL=https://...
EOF
  exit 1
}

sync_content_repo() {
  ensure_content_repo_ready
  require_command git

  if [[ -n "$CONTENT_REPO_REF" ]]; then
    git -C "$CONTENT_REPO_ROOT" fetch --all --prune >/dev/null 2>&1 || true
    git -C "$CONTENT_REPO_ROOT" checkout "$CONTENT_REPO_REF" >/dev/null 2>&1 || true
    git -C "$CONTENT_REPO_ROOT" pull --ff-only >/dev/null 2>&1 || true
  fi
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$cmd" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage:
  agent-workflow setup                              # Install dependencies and verify auth
  agent-workflow doctor                             # JSON health check for tooling and repo wiring
  agent-workflow sync-content-repo                  # Refresh the managed content repo clone
  agent-workflow backlog [wiki-automation backlog args...]
  agent-workflow queue [wiki-automation queue args...]
  agent-workflow match "<title or topic>" [wiki-automation match args...]
  agent-workflow search "<query>" [wiki-automation search args...]
  agent-workflow prepare "<url>" [wiki-automation prepare args...]
  agent-workflow intake "<url-or-pdf>" [wiki-automation intake args...]
  agent-workflow ingest-paper "<source>" [wiki-automation ingest-paper args...]
  agent-workflow append "<url>" --target "<path>" [wiki-automation append args...]
  agent-workflow tags [--suggest "<query>"] [--limit N]
  agent-workflow audit-tags [wiki-automation audit-tags args...]
  agent-workflow lint-frontmatter [wiki-automation lint-frontmatter args...]
  agent-workflow check-ref "<url>"
  agent-workflow check-duplicate-paper "<identifier>"
  agent-workflow archive-source "<source>" [wiki-automation archive-source args...]
  agent-workflow open-pr [wiki-automation open-pr args...]
  agent-workflow publish-pr [wiki-automation publish-pr args...]
  agent-workflow triage-ui [gmail-reader-web args...]   # LAN web UI for SQLite triage
  agent-workflow help

Authentication:
  source auth-bootstrap                             # Load Google credentials from Vault
EOF
}

run_wiki_command() {
  require_command uv
  ensure_content_repo_ready
  CONTENT_REPO_ROOT="$CONTENT_REPO_ROOT" AGENT_TOOLS_ROOT="$AGENT_TOOLS_ROOT" \
    uv run --directory "$WIKI_AUTOMATION_DIR" wiki-automation "$@"
}

run_queue() {
  ensure_content_repo_ready

  local gmail_query="label:inbox newer_than:1d"
  local days_back="1"
  local max_messages="25"
  local max_results="10"
  local output_dir="$DEFAULT_OUTPUT_DIR"

  local passthrough=()
  while (($#)); do
    case "$1" in
      --gmail-query|--days-back|--max-messages|--max-results|--output-dir)
        if (($# < 2)); then
          printf 'Missing value for %s\n' "$1" >&2
          exit 1
        fi
        case "$1" in
          --gmail-query) gmail_query="$2" ;;
          --days-back) days_back="$2" ;;
          --max-messages) max_messages="$2" ;;
          --max-results) max_results="$2" ;;
          --output-dir) output_dir="$2" ;;
        esac
        shift 2
        ;;
      *)
        passthrough+=("$1")
        shift
        ;;
    esac
  done

  run_wiki_command queue \
    --gmail-query "$gmail_query" \
    --days-back "$days_back" \
    --max-messages "$max_messages" \
    --max-results "$max_results" \
    --output-dir "$output_dir" \
    "${passthrough[@]}"
}

run_match() {
  if (($# < 1)); then
    printf 'match requires a title or topic\n' >&2
    exit 1
  fi

  run_wiki_command match "$@"
}

